PORT=3000

# ── AI engines ────────────────────────────────────────────────────────────
# Groq is the PRIMARY engine (free key: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
# Gemini is used automatically as a fallback if Groq fails
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── Place verification & destination resolution ───────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── Optional media / weather ──────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here   # من unsplash.com/developers (مجاني)
PEXELS_API_KEY=your_pexels_api_key_here             # من pexels.com/api (مجاني)
OPENWEATHER_API_KEY=your_openweather_api_key_here   # من openweathermap.org (مجاني)

# ── Admin-only routes (send-test-push, test-alert) ────────────────────────
# Comma-separated Firebase uids allowed to call /api/admin/* routes.
# ADMIN_UIDS=uid1,uid2

# ── Critical error alerting (optional) ─────────────────────────────────────
# If unset, critical errors are still written to the `error_logs` Firestore
# collection (when FIREBASE_SERVICE_ACCOUNT is set) but no Telegram alert is
# sent. Create a bot via @BotFather to get a token, then message it once and
# call https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Minimum time between repeat alerts for the same error category (ms).
# ERROR_ALERT_COOLDOWN_MS=900000
